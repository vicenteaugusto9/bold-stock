generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────── ENUMS ────────────────

enum Role {
  ADMIN
  VENDEDOR
  ESTOQUISTA
}

enum SaleStatus {
  PENDING     // aguardando pagamento
  CONFIRMED   // pagamento confirmado
  CANCELLED   // cancelado
}

enum PaymentMethod {
  PIX
  CARD
  CASH
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum MovementType {
  ENTRY       // entrada de mercadoria
  EXIT        // saída por venda
  RESERVE     // soft lock
  RELEASE     // liberação de reserva
  ADJUSTMENT  // ajuste manual
}

// ──────────────── MODELS ────────────────

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  role      Role       @default(VENDEDOR)
  sales     Sale[]
  logs      AuditLog[]
  createdAt DateTime   @default(now())
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  document  String   @unique  // CPF ou CNPJ
  email     String?  @unique
  phone     String?
  active    Boolean  @default(true)
  sales     Sale[]
  createdAt DateTime @default(now())
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Product {
  id         String     @id @default(uuid())
  name       String
  sku        String     @unique  // código único do produto
  price      Decimal              // preço de venda
  costPrice  Decimal              // preço de custo (margem de lucro)
  unit       String     @default("UN")  // UN, KG, CX...
  active     Boolean    @default(true)
  categoryId String
  category   Category   @relation(fields: [categoryId], references: [id])
  stock      Stock?
  saleItems  SaleItem[]
  createdAt  DateTime   @default(now())
}

model Stock {
  id        String          @id @default(uuid())
  productId String          @unique
  product   Product         @relation(fields: [productId], references: [id])
  available Int             @default(0)  // disponível para venda
  reserved  Int             @default(0)  // aguardando pagamento (soft lock)
  movements StockMovement[]
  updatedAt DateTime        @updatedAt
}

model StockMovement {
  id            String       @id @default(uuid())
  stockId       String
  stock         Stock        @relation(fields: [stockId], references: [id])
  type          MovementType
  quantity      Int
  correlationId String?      // liga ao pedido que gerou a movimentação
  createdAt     DateTime     @default(now())
}

model Sale {
  id            String      @id @default(uuid())
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  status        SaleStatus  @default(PENDING)
  total         Decimal
  correlationId String      @unique @default(uuid()) // rastreia todo o fluxo
  items         SaleItem[]
  payment       Payment?
  createdAt     DateTime    @default(now())
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal // preço fixado no momento da venda
}

model Payment {
  id             String        @id @default(uuid())
  saleId         String        @unique
  sale           Sale          @relation(fields: [saleId], references: [id])
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  idempotencyKey String        @unique // evita cobrança duplicada
  amount         Decimal
  createdAt      DateTime      @default(now())
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  action        String   // SALE_CREATED, STOCK_RESERVED, PAYMENT_CONFIRMED...
  correlationId String?  // liga todos os logs de uma mesma operação
  details       Json
  createdAt     DateTime @default(now())
}
